{
	# 禁用自动 http->https 重定向 (微信校验文件需要在 80 端口直接返回内容)
	# 证书自动签发/续期不受影响
	auto_https disable_redirects
}

http://lyldalek.top {
	# route 保持书写顺序: 校验文件必须先于 redir 匹配 (Caddy 默认排序会把 redir 排到 handle 前面)
	route {
		handle /281efb83f68f730d38e8d6787172a026.txt {
			respond "5d73d898e3d816e9d6c008b38782f5082560493a"
		}
		redir * https://lyldalek.top{uri} 308
	}
}

lyldalek.top {
	# 根路径直接进入应用 (无子路径)
	reverse_proxy app:3000
}

# 备案拦截临时绕行端口 (阿里云只拦 80/443; 备案接入完成后可移除)
# 服务器访问 Let's Encrypt 超时, 8443 直接复用已有证书 (不走 ACME)
lyldalek.top:8443 {
	tls /data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/lyldalek.top/lyldalek.top.crt /data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/lyldalek.top/lyldalek.top.key
	reverse_proxy app:3000
}
